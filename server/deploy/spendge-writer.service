[Unit]
Description=spendge write-behind worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/spendge-server
EnvironmentFile=-/home/ubuntu/spendge-server/.env
ExecStart=/home/ubuntu/spendge-server/.venv/bin/python -m app.writer
Restart=on-failure
RestartSec=2
MemoryMax=200M

[Install]
WantedBy=multi-user.target
