[Unit]
Description=spendge backend (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/spendge-server
EnvironmentFile=-/home/ubuntu/spendge-server/.env
ExecStart=/home/ubuntu/spendge-server/.venv/bin/gunicorn -w 2 --threads 4 -b 127.0.0.1:8010 --timeout 90 --max-requests 800 --max-requests-jitter 100 app.main:app
Restart=on-failure
RestartSec=2
MemoryMax=700M

[Install]
WantedBy=multi-user.target
